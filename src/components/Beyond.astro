---
import WorldMap from './WorldMap.astro';
import { t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="section shell" id="beyond" aria-labelledby="beyond-label">
  <h2 class="section-label" id="beyond-label" data-reveal style="--delay:0ms">{s.beyond.label}</h2>

  <ul class="beyond-list">
    {s.beyond.items.map((item, i) => <li data-reveal style={`--delay:${70 + i * 70}ms`}>{item}</li>)}
  </ul>

  <div data-reveal style="--delay:240ms">
    <WorldMap locale={locale} />
  </div>

  <p class="values" data-reveal style="--delay:320ms">{s.beyond.values}</p>
</section>
