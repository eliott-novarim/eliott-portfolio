---
import { t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="section shell" id="experience" aria-labelledby="experience-label">
  <h2 class="section-label" id="experience-label" data-reveal style="--delay:0ms">{s.experience.label}</h2>

  <div class="rows" data-rows>
    <div class="row-marker" aria-hidden="true"></div>
    {
      s.experience.items.map((item, i) => (
        <article class="row" data-row data-reveal style={`--delay:${70 + i * 70}ms`}>
          <p class="row-years">{item.years}</p>
          <h3 class="row-title">{item.role}{item.org ? <>{', '}<strong>{item.org}</strong></> : null}</h3>
          <p class="row-detail">{item.detail}</p>
        </article>
      ))
    }
  </div>
</section>
